# Chép thành .env ở thư mục gốc dự án rồi sửa cho máy chạy thật.
# Mạng nội bộ: localhost và IP LAN của máy chủ (Caddy tự cấp chứng chỉ nội bộ).
SITE_ADDRESS=localhost, 192.168.1.50
# Khi vào bằng IP, trình duyệt không gửi tên miền: đặt bằng IP LAN ở trên.
DEFAULT_SNI=192.168.1.50
# Có tên miền trỏ về máy chủ (mở cổng 80/443): Caddy tự lấy chứng chỉ Let's Encrypt.
# SITE_ADDRESS=baove.truong.edu.vn
# Mật khẩu quản trị ban đầu (chỉ dùng khi cơ sở dữ liệu chưa có tài khoản).
ADMIN_PASSWORD=doi-mat-khau-nay
