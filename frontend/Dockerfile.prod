# Bản chạy thật: build giao diện thành file tĩnh, phục vụ bằng Caddy (HTTPS + chuyển /api sang API).
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
EXPOSE 80 443
